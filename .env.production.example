# Valores para producción: copia este fichero como .env en el servidor y rellena lo marcado.
# Arranque: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Si algo no es seguro, php-fpm no arranca y lo explica (php artisan seguridad:comprobar).

APP_NAME="Programa Agrario"
APP_ENV=production
# APP_KEY: generar con  php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://RELLENAR-dominio.es
APP_LOCALE=es_ES
APP_FALLBACK_LOCALE=es_ES

# notice conserva las acciones del backoffice (bloqueos, borrados) sin el ruido de debug/info;
# un fichero por día durante 30 días
LOG_CHANNEL=daily
LOG_LEVEL=notice
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=agrario
DB_USERNAME=agrario
DB_PASSWORD=RELLENAR-contraseña-larga-y-aleatoria

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Mayor que el timeout del job más largo (LanzarTarea, 900 s) para que no se reintente mientras corre
REDIS_QUEUE_RETRY_AFTER=960
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=RELLENAR-servidor-smtp
MAIL_PORT=587
MAIL_USERNAME=RELLENAR
MAIL_PASSWORD=RELLENAR
MAIL_FROM_ADDRESS=RELLENAR@dominio.es
MAIL_FROM_NAME="${APP_NAME}"

AEMET_API_KEY=RELLENAR

# Copias de seguridad: cifradas (obligatorio en producción) y fuera de carpetas sincronizadas.
# Guarda la frase en un gestor de contraseñas: sin ella no se puede restaurar ninguna copia.
BACKUP_PASSPHRASE=RELLENAR-frase-larga
BACKUP_DIR=/srv/agriculnet/backups

# Certificados HTTPS: carpeta con fullchain.pem y privkey.pem copiados (cp -L) de Let's Encrypt,
# que usa enlaces simbólicos que no se ven dentro del contenedor (ver README «Producción»)
CERTS_DIR=/srv/agriculnet/certs
